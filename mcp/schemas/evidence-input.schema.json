{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bright.local/schemas/evidence-input.schema.json",
  "title": "Bright Evidence Normalize Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "items"],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "aliases": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "researchQuery": {"type": "string", "maxLength": 2000},
    "researchedAt": {"type": "string", "maxLength": 64},
    "items": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "object"}},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxEvidence": {"type": "integer", "minimum": 1, "maximum": 200},
        "nearDuplicateThreshold": {"type": "number", "minimum": 0.5, "maximum": 0.99}
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim", "url"],
      "properties": {
        "claim": {"type": "string", "minLength": 3, "maxLength": 2000},
        "url": {"type": "string", "maxLength": 4096, "pattern": "^https?://"},
        "title": {"type": "string", "maxLength": 1000},
        "publisher": {"type": "string", "maxLength": 500},
        "author": {"type": "string", "maxLength": 500},
        "publishedAt": {"type": "string", "maxLength": 64},
        "excerpt": {"type": "string", "maxLength": 1500},
        "category": {"type": "string", "maxLength": 128},
        "sourceType": {"type": "string", "maxLength": 64},
        "sourceRelationship": {"type": "string", "maxLength": 64},
        "claimDate": {"type": "string", "maxLength": 64},
        "value": {"type": ["string", "number", "boolean"]},
        "unit": {"type": "string", "maxLength": 128}
      }
    }
  }
}
