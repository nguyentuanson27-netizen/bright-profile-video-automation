# Standalone app / worker
BRIGHT_PORT=4180
BRIGHT_DATA_DIR=./data
BRIGHT_DATABASE_PATH=./data/bright-profile.sqlite
# Optional comma-separated public UI hostnames. Default is loopback-only.
BRIGHT_ALLOWED_BROWSER_HOSTS=
WORKER_LEASE_MS=30000
WORKER_MAX_RETRIES=3

# Safe public media fetch
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=26214400
FETCH_MAX_REDIRECTS=5

# Optional: retained standalone research + structured generation only.
# ChatGPT MCP imports that include both EvidenceBundle and draft do not use this key.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_GENERATION_MODEL=gpt-5
OPENAI_API_TIMEOUT_MS=60000
OPENAI_API_MAX_RETRIES=2

# Google Cloud TTS. Keep the credential file outside Git; Compose mounts it read-only into worker.
GOOGLE_APPLICATION_CREDENTIALS_FILE=./.secrets/google-application-credentials.json
GOOGLE_TTS_LANGUAGE=vi-VN
GOOGLE_TTS_VOICE=vi-VN-Neural2-D
GOOGLE_TTS_SPEAKING_RATE=1.03
TTS_MAX_SPEED=1.35
TTS_END_GAP_SECONDS=0.18

# Bright Evidence MCP remote endpoint (reverse-proxied HTTPS)
MCP_PUBLIC_URL=https://video.lanadesign.tech/mcp
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_MAX_BODY_BYTES=2097152
MCP_RATE_LIMIT_PER_MINUTE=20
MCP_REQUEST_TIMEOUT_MS=10000
MCP_NOAUTH_WRITE_ENABLED=false
MCP_MAX_INFLIGHT_WRITE_REQUESTS=2

# Private MCP-to-Backend Integration
BRIGHT_INTEGRATION_TOKEN=replace-with-internal-service-token
# For Docker Compose deployments MCP dials http://app:4180; for local standalone Node processes without Docker use http://127.0.0.1:4180
BRIGHT_BACKEND_URL=http://app:4180
# Authoritative active project admission cap for ChatGPT integration (default 3, max 100). MCP_MAX_ACTIVE_PROJECTS is supported as fallback alias if this variable is unset.
BRIGHT_CHATGPT_MAX_ACTIVE_PROJECTS=3
