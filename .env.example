BRIGHT_IMAGE=ghcr.io/nguyentuanson27-netizen/bright-profile-video-automation:sha-REPLACE_WITH_GIT_SHA
APP_DOMAIN=profile.example.com
BRIGHT_EDGE_SUBNET=172.30.0.0/24
CADDY_EDGE_IP=172.30.0.10

GITHUB_ALLOWED_USERS=your-github-username
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET_FILE=/srv/bright-profile/secrets/github-oauth-client-secret
OAUTH2_PROXY_COOKIE_SECRET_FILE=/srv/bright-profile/secrets/oauth2-proxy-cookie-secret
GOOGLE_TTS_CREDENTIALS_FILE=/srv/bright-profile/secrets/google-tts.json

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_RESEARCH_MODEL=replace-with-explicit-dated-model-snapshot
OPENAI_GENERATION_MODEL=replace-with-explicit-dated-model-snapshot
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_GENERATION_MAX_OUTPUT_TOKENS=12000

COMPLETED_ARTIFACT_RETENTION_DAYS=30
TRANSIENT_ARTIFACT_RETENTION_DAYS=7
DISK_WARNING_FREE_PERCENT=25
DISK_HARD_FREE_PERCENT=15
DISK_HARD_FREE_GIB=20

GOOGLE_TTS_LANGUAGE=vi-VN
GOOGLE_TTS_VOICE=vi-VN-Neural2-D
GOOGLE_TTS_SPEAKING_RATE=1.03
TTS_MAX_SPEED=1.35
TTS_END_GAP_SECONDS=0.18
