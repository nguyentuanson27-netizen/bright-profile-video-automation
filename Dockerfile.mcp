FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY --chown=node:node domain ./domain
COPY --chown=node:node lib/evidence ./lib/evidence
COPY --chown=node:node security ./security
COPY --chown=node:node mcp ./mcp

USER node
ENV NODE_ENV=production \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=4190 \
    MCP_ALLOWED_HOSTS=127.0.0.1,localhost \
    MCP_MAX_BODY_BYTES=2097152 \
    MCP_RATE_LIMIT_PER_MINUTE=20 \
    MCP_REQUEST_TIMEOUT_MS=10000 \
    MCP_NOAUTH_WRITE_ENABLED=false \
    MCP_MAX_ACTIVE_PROJECTS=3 \
    MCP_MAX_INFLIGHT_WRITE_REQUESTS=2

EXPOSE 4190
HEALTHCHECK --interval=5s --timeout=3s --start-period=2s --retries=3 \
    CMD ["node", "-e", "require('node:http').get('http://127.0.0.1:4190/health',r=>{let b='';r.setEncoding('utf8');r.on('data',c=>b+=c);r.on('end',()=>{if(r.statusCode!==200){console.error('health status='+r.statusCode+' body='+b);process.exit(1)}})}).on('error',e=>{console.error(e.message);process.exit(1)})"]

CMD ["node", "mcp/server.mjs"]
